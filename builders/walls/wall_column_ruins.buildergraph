name = "Wall Column Ruins";
host = sector;

param radius = 0.16;
param spacing = 1.7;
param base = 0.22;
param cap = 0.18;
param transition = 0.08;
param broken_chance = 0.45;
param broken_min_height = 0.32;
param seed = 17.0;
param placement = structural;

preview {
    width = 7.0;
    depth = 2.6;
    height = 0.3;
    surface = wall;
}

cut rect {
    min = vec2(host.width * 0.08, 0.0);
    max = vec2(host.width * 0.92, host.depth);
    mode = cut;
};

detail masonry {
    min = vec2(host.width * 0.04, host.depth * 0.12);
    max = vec2(host.width * 0.96, host.depth * 0.92);
    block = vec2(0.52, 0.28);
    mortar = 0.04;
    offset = -0.045;
    pattern = running_bond;
    material = STONE;
    tile_alias = stone;
};

detail columns {
    start = host.width * 0.08;
    end = host.width * 0.92;
    y = 0.0;
    spacing = spacing;
    height = host.depth;
    radius = radius;
    base = base;
    cap = cap;
    transition = transition;
    broken_chance = broken_chance;
    broken_min_height = broken_min_height;
    seed = seed;
    segments = 16;
    placement = placement;
    material = COLUMN;
    rect_material = BLOCK;
    cyl_material = SHAFT;
    tile_alias = stone;
};

output = [];
