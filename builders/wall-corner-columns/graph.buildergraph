name = "Wall Corner Columns";
host = sector;

param radius = 0.16;
param placement = attached;

preview {
    width = 5.5;
    depth = 2.6;
    height = 0.3;
    surface = wall;
}

detail columns {
    start = host.width * 0.08;
    end = host.width * 0.92;
    y = 0.0;
    spacing = host.width;
    height = host.depth;
    radius = radius;
    offset = -radius;
    base = 0.22;
    cap = 0.22;
    transition = 0.10;
    segments = 16;
    placement = placement;
    material = COLUMN;
    rect_material = BLOCK;
    cyl_material = SHAFT;
    tile_alias = stone;
};

output = [];
