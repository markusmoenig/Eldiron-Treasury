name = "Farmhouse Skeleton";
host = sector;

param seed = 12.0;
param wall_height = 1.6;
param roof_height = 0.85;
param plank_spacing = 0.28;
param roof_plank_spacing = 0.16;
param missing_plank_percent = 22.0;
param plank_unevenness = 0.85;
param overhang = 0.18;
param beam_size = 0.10;
param wall_panel_height = wall_height - beam_size;
param end_opening_width = 0.95;
param end_panel_width = (host.depth - end_opening_width) * 0.5;
param roof_run = host.depth * 0.5 + overhang;
param roof_pitch = atan(roof_run / roof_height);
param roof_slope_length = sqrt(roof_run * roof_run + roof_height * roof_height);
param plank_count = host.width / plank_spacing;
param end_plank_count = host.depth / plank_spacing;
param roof_plank_count = roof_slope_length / roof_plank_spacing;

preview {
    width = 4.8;
    depth = 3.2;
    height = 2.6;
}

let north_planks = planks {
    attach = host.middle + host.up * beam_size + host.out * (host.depth * -0.5 - 0.095);
    size = vec3(host.width * 0.96, wall_panel_height, 0.035);
    count = plank_count;
    direction = vertical;
    jitter = 0.0;
    unevenness = plank_unevenness;
    missing_chance = missing_plank_percent * 0.01;
    seed = seed;
    material = PLANK;
};

let south_planks = planks {
    attach = host.middle + host.up * beam_size + host.out * (host.depth * 0.5 + 0.095);
    size = vec3(host.width * 0.96, wall_panel_height, 0.035);
    count = plank_count;
    direction = vertical;
    jitter = 0.0;
    unevenness = plank_unevenness;
    missing_chance = missing_plank_percent * 0.01;
    seed = seed * 2.0;
    material = PLANK;
};

let west_north_planks = planks {
    attach = host.middle + host.up * beam_size + host.along * (host.width * -0.5 - 0.095) + host.out * (host.depth * -0.5 + end_panel_width * 0.5);
    size = vec3(end_panel_width, wall_panel_height, 0.035);
    count = end_plank_count * 0.35;
    direction = vertical;
    jitter = 0.0;
    unevenness = plank_unevenness;
    missing_chance = missing_plank_percent * 0.01;
    seed = seed * 5.0;
    rotate_y = 1.5708;
    material = PLANK;
};

let west_south_planks = planks {
    attach = host.middle + host.up * beam_size + host.along * (host.width * -0.5 - 0.095) + host.out * (host.depth * 0.5 - end_panel_width * 0.5);
    size = vec3(end_panel_width, wall_panel_height, 0.035);
    count = end_plank_count * 0.35;
    direction = vertical;
    jitter = 0.0;
    unevenness = plank_unevenness;
    missing_chance = missing_plank_percent * 0.01;
    seed = seed * 5.5;
    rotate_y = 1.5708;
    material = PLANK;
};

let east_north_planks = planks {
    attach = host.middle + host.up * beam_size + host.along * (host.width * 0.5 + 0.095) + host.out * (host.depth * -0.5 + end_panel_width * 0.5);
    size = vec3(end_panel_width, wall_panel_height, 0.035);
    count = end_plank_count * 0.35;
    direction = vertical;
    jitter = 0.0;
    unevenness = plank_unevenness;
    missing_chance = missing_plank_percent * 0.01;
    seed = seed * 6.0;
    rotate_y = 1.5708;
    material = PLANK;
};

let east_south_planks = planks {
    attach = host.middle + host.up * beam_size + host.along * (host.width * 0.5 + 0.095) + host.out * (host.depth * 0.5 - end_panel_width * 0.5);
    size = vec3(end_panel_width, wall_panel_height, 0.035);
    count = end_plank_count * 0.35;
    direction = vertical;
    jitter = 0.0;
    unevenness = plank_unevenness;
    missing_chance = missing_plank_percent * 0.01;
    seed = seed * 6.5;
    rotate_y = 1.5708;
    material = PLANK;
};

let post_nw = box {
    attach = host.middle + host.along * (host.width * -0.5) + host.out * (host.depth * -0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let post_ne = box {
    attach = host.middle + host.along * (host.width * 0.5) + host.out * (host.depth * -0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let post_sw = box {
    attach = host.middle + host.along * (host.width * -0.5) + host.out * (host.depth * 0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let post_w_door_n = box {
    attach = host.middle + host.along * (host.width * -0.5) + host.out * (end_opening_width * -0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let post_w_door_s = box {
    attach = host.middle + host.along * (host.width * -0.5) + host.out * (end_opening_width * 0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let post_se = box {
    attach = host.middle + host.along * (host.width * 0.5) + host.out * (host.depth * 0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let post_e_door_n = box {
    attach = host.middle + host.along * (host.width * 0.5) + host.out * (end_opening_width * -0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let post_e_door_s = box {
    attach = host.middle + host.along * (host.width * 0.5) + host.out * (end_opening_width * 0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let post_mid_n = box {
    attach = host.middle + host.out * (host.depth * -0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let post_mid_s = box {
    attach = host.middle + host.out * (host.depth * 0.5);
    size = vec3(beam_size, wall_height, beam_size);
    material = BEAM;
};

let sill_n = box {
    attach = host.middle + host.out * (host.depth * -0.5 - 0.02);
    size = vec3(host.width + beam_size, beam_size, beam_size);
    material = BEAM;
};

let sill_s = box {
    attach = host.middle + host.out * (host.depth * 0.5 + 0.02);
    size = vec3(host.width + beam_size, beam_size, beam_size);
    material = BEAM;
};

let sill_w_n = box {
    attach = host.middle + host.along * (host.width * -0.5 - 0.02) + host.out * (host.depth * -0.5 + end_panel_width * 0.5);
    size = vec3(end_panel_width + beam_size, beam_size, beam_size);
    rotate_y = 1.5708;
    material = BEAM;
};

let sill_w_s = box {
    attach = host.middle + host.along * (host.width * -0.5 - 0.02) + host.out * (host.depth * 0.5 - end_panel_width * 0.5);
    size = vec3(end_panel_width + beam_size, beam_size, beam_size);
    rotate_y = 1.5708;
    material = BEAM;
};

let sill_e_n = box {
    attach = host.middle + host.along * (host.width * 0.5 + 0.02) + host.out * (host.depth * -0.5 + end_panel_width * 0.5);
    size = vec3(end_panel_width + beam_size, beam_size, beam_size);
    rotate_y = 1.5708;
    material = BEAM;
};

let sill_e_s = box {
    attach = host.middle + host.along * (host.width * 0.5 + 0.02) + host.out * (host.depth * 0.5 - end_panel_width * 0.5);
    size = vec3(end_panel_width + beam_size, beam_size, beam_size);
    rotate_y = 1.5708;
    material = BEAM;
};

let plate_n = box {
    attach = host.middle + host.up * wall_height + host.out * (host.depth * -0.5 - 0.02);
    size = vec3(host.width + beam_size, beam_size, beam_size);
    material = BEAM;
};

let plate_s = box {
    attach = host.middle + host.up * wall_height + host.out * (host.depth * 0.5 + 0.02);
    size = vec3(host.width + beam_size, beam_size, beam_size);
    material = BEAM;
};

let plate_w = box {
    attach = host.middle + host.up * wall_height + host.along * (host.width * -0.5 - 0.02);
    size = vec3(host.depth + beam_size, beam_size, beam_size);
    rotate_y = 1.5708;
    material = BEAM;
};

let plate_e = box {
    attach = host.middle + host.up * wall_height + host.along * (host.width * 0.5 + 0.02);
    size = vec3(host.depth + beam_size, beam_size, beam_size);
    rotate_y = 1.5708;
    material = BEAM;
};

let ridge = box {
    attach = host.middle + host.up * (wall_height + roof_height);
    size = vec3(host.width + overhang * 2.0, beam_size, beam_size);
    material = BEAM;
};

let roof_north = box {
    attach = host.middle + host.up * (wall_height) + host.out * (host.depth * -0.5 - overhang);
    size = vec3(host.width + overhang * 2.0, roof_slope_length, 0.08);
    rotate_x = roof_pitch;
    material = ROOF;
};

let roof_south = box {
    attach = host.middle + host.up * (wall_height) + host.out * (host.depth * 0.5 + overhang);
    size = vec3(host.width + overhang * 2.0, roof_slope_length, 0.08);
    rotate_x = roof_pitch * -1.0;
    material = ROOF;
};

let roof_north_planks = planks {
    attach = host.middle + host.up * (wall_height + 0.05) + host.out * (host.depth * -0.5 - overhang);
    size = vec3(host.width + overhang * 2.0, roof_slope_length, 0.035);
    count = roof_plank_count;
    direction = horizontal;
    jitter = 0.45;
    unevenness = plank_unevenness;
    missing_chance = missing_plank_percent * 0.0045;
    seed = seed * 3.0;
    rotate_x = roof_pitch;
    material = ROOF_PLANK;
};

let roof_south_planks = planks {
    attach = host.middle + host.up * (wall_height + 0.05) + host.out * (host.depth * 0.5 + overhang);
    size = vec3(host.width + overhang * 2.0, roof_slope_length, 0.035);
    count = roof_plank_count;
    direction = horizontal;
    jitter = 0.45;
    unevenness = plank_unevenness;
    missing_chance = missing_plank_percent * 0.0045;
    seed = seed * 4.0;
    rotate_x = roof_pitch * -1.0;
    material = ROOF_PLANK;
};

let rafter_nw = box {
    attach = host.middle + host.along * (host.width * -0.5) + host.up * wall_height + host.out * (host.depth * -0.5 - overhang);
    size = vec3(beam_size, roof_slope_length, beam_size);
    rotate_x = roof_pitch;
    material = BEAM;
};

let rafter_ne = box {
    attach = host.middle + host.along * (host.width * 0.5) + host.up * wall_height + host.out * (host.depth * -0.5 - overhang);
    size = vec3(beam_size, roof_slope_length, beam_size);
    rotate_x = roof_pitch;
    material = BEAM;
};

let rafter_sw = box {
    attach = host.middle + host.along * (host.width * -0.5) + host.up * wall_height + host.out * (host.depth * 0.5 + overhang);
    size = vec3(beam_size, roof_slope_length, beam_size);
    rotate_x = roof_pitch * -1.0;
    material = BEAM;
};

let rafter_se = box {
    attach = host.middle + host.along * (host.width * 0.5) + host.up * wall_height + host.out * (host.depth * 0.5 + overhang);
    size = vec3(beam_size, roof_slope_length, beam_size);
    rotate_x = roof_pitch * -1.0;
    material = BEAM;
};

let rafter_mid_n = box {
    attach = host.middle + host.up * wall_height + host.out * (host.depth * -0.5 - overhang);
    size = vec3(beam_size, roof_slope_length, beam_size);
    rotate_x = roof_pitch;
    material = BEAM;
};

let rafter_mid_s = box {
    attach = host.middle + host.up * wall_height + host.out * (host.depth * 0.5 + overhang);
    size = vec3(beam_size, roof_slope_length, beam_size);
    rotate_x = roof_pitch * -1.0;
    material = BEAM;
};

slot material wall_mat = post_nw.center;
slot material plank_mat = north_planks.center;
slot material roof_mat = roof_north_planks.center;
slot material beam_mat = ridge.center;

output = [post_nw, post_ne, post_sw, post_se, post_w_door_n, post_w_door_s, post_e_door_n, post_e_door_s, post_mid_n, post_mid_s, sill_n, sill_s, sill_w_n, sill_w_s, sill_e_n, sill_e_s, plate_n, plate_s, plate_w, plate_e, ridge, rafter_nw, rafter_ne, rafter_sw, rafter_se, rafter_mid_n, rafter_mid_s, north_planks, south_planks, west_north_planks, west_south_planks, east_north_planks, east_south_planks, roof_north_planks, roof_south_planks];
